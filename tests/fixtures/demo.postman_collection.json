{
  "info": { "name": "Postman demo import", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [{ "key": "baseUrl", "value": "https://jsonplaceholder.typicode.com" }],
  "item": [{ "name": "Users", "item": [
    { "name": "List users", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/users?id=1", "query": [{ "key": "id", "value": "1" }] }, "header": [{ "key": "Accept", "value": "application/json" }] } },
    { "name": "Create user", "request": { "method": "POST", "url": "{{baseUrl}}/users", "body": { "mode": "raw", "raw": "{\"name\":\"Demo\"}", "options": { "raw": { "language": "json" } } } } }
  ] }]
}
